# Copy to .env inside database/ when running Docker PostgreSQL locally. NEVER commit .env.

POSTGRES_USER=udyam
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=udyam_pay
POSTGRES_PORT=5432

# Used by Prisma CLI when running commands from database/
DATABASE_URL=postgresql://udyam:change-me-local-only@localhost:5432/udyam_pay?schema=public
